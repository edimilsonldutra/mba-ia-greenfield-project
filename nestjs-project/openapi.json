      "VideoMetadataDto": {
        "type": "object",
        "properties": {
          "width": {
            "type": "number",
            "example": 1920
          },
          "height": {
            "type": "number",
            "example": 1080
          },
          "frame_rate": {
            "type": "number",
            "nullable": true,
            "example": 29.97
          },
          "video_codec": {
            "type": "string",
            "example": "h264"
          },
          "audio_codec": {
            "type": "string",
            "nullable": true,
            "example": "aac"
          },
          "bit_rate": {
            "type": "number",
            "nullable": true,
            "example": 800000
          },
          "format": {
            "type": "string",
            "example": "mov,mp4,m4a,3gp,3g2,mj2"
          }
        },
        "required": [
          "width",
          "height",
          "frame_rate",
          "video_codec",
          "audio_codec",
          "bit_rate",
          "format"
        ]
      },
      "VideoStatusDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string",
            "example": "dQw4w9WgXcQ"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "processing",
              "ready",
              "failed"
            ]
          },
          "failure_reason": {
            "type": "string",
            "enum": [
              "INVALID_VIDEO",
              "PROCESSING_ERROR"
            ],
            "nullable": true
          },
          "duration_seconds": {
            "type": "number",
            "nullable": true,
            "example": 212.5
          },
          "metadata": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoMetadataDto"
              }
            ]
          }
        },
        "required": [
          "id",
          "slug",
          "status",
          "failure_reason",
          "duration_seconds",
          "metadata"
        ]
      },
      "VideoChannelDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "My channel"
          },
          "nickname": {
            "type": "string",
            "example": "my_channel"
          }
        },
        "required": [
          "name",
          "nickname"
        ]
      },
      "VideoDetailsDto": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "example": "dQw4w9WgXcQ"
          },
          "title": {
            "type": "string",
            "example": "My holiday"
          },
          "duration_seconds": {
            "type": "number",
            "example": 212.5
          },
          "metadata": {
            "$ref": "#/components/schemas/VideoMetadataDto"
          },
          "channel": {
            "$ref": "#/components/schemas/VideoChannelDto"
          },
          "stream_url": {
            "type": "string",
            "example": "/videos/dQw4w9WgXcQ/stream"
          },
          "thumbnail_url": {
            "type": "string",
            "example": "/videos/dQw4w9WgXcQ/thumbnail"
          },
          "download_url": {
            "type": "string",
            "example": "/videos/dQw4w9WgXcQ/download"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "slug",
          "title",
          "duration_seconds",
          "metadata",
          "channel",
          "stream_url",
          "thumbnail_url",
          "download_url",
          "created_at"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}